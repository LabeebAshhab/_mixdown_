# Copy this file to .env and change what you need. Every line is optional.

# ---- Access ---------------------------------------------------------------
# Set a password to keep the app private. Leave empty for open access.
ACCESS_PASSWORD=
# Behind a reverse proxy (nginx, Caddy, Traefik, Cloudflare Tunnel) set this to
# the number of proxies in front of the app, usually 1. Without it every
# visitor looks like the same address and shares one rate limit and quota.
TRUST_PROXY=1
# Set to 1 when the site is served over https, so the session cookie is Secure.
COOKIE_SECURE=1

# ---- Storage --------------------------------------------------------------
# Space one visitor may have waiting to be downloaded.
QUOTA_GB=3
# Space all visitors together may use.
TOTAL_STORAGE_GB=20
# Minutes a finished file waits before it is deleted if nobody downloads it.
FILE_TTL_MINUTES=15

# ---- Limits ---------------------------------------------------------------
MAX_TRACKS=100            # tracks taken from one playlist
MAX_TRACK_MINUTES=90      # longest single video
MAX_SOURCE_MB=500         # largest source download
MAX_UPLOAD_MB=100         # largest file the inspector accepts
MAX_CONCURRENT=2          # links processed at the same time
MAX_JOBS_PER_CLIENT=3     # links one visitor may have in progress
RATE_CONVERT_PER_MIN=5    # new links per minute, per visitor
RATE_GLOBAL_PER_MIN=300   # all requests per minute, per visitor
DOWNLOAD_TIMEOUT_SEC=600
CONVERT_TIMEOUT_SEC=900

# ---- Metadata -------------------------------------------------------------
METADATA_LOOKUP=on        # off = tag from YouTube data only
LYRICS=on                 # off = never look up lyrics
ITUNES_COUNTRY=US

# ---- Footer credits -------------------------------------------------------
CREDIT_NAME=Labeeb Ashhab
CREDIT_GITHUB=https://github.com/LabeebAshhab
CREDIT_WEBSITE=https://me.astroit.org
