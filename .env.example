# Copy this file to .env and change what you need. Every line is optional.

# ---- Access ---------------------------------------------------------------
# Set a password to keep the app private. Leave empty for open access.
ACCESS_PASSWORD=
# Behind a reverse proxy (nginx, Caddy, Traefik, Cloudflare Tunnel) set this to
# the number of proxies in front of the app, usually 1. Without it every
# visitor looks like the same address and shares one rate limit and quota.
TRUST_PROXY=1
# Set to 1 when the site is served over https, so the session cookie is Secure.
COOKIE_SECURE=1
# The site's public https address. Used only so that a link to the site shared
# in a chat or on a social site shows its preview image.
PUBLIC_URL=

# ---- Storage --------------------------------------------------------------
# Space one browser may have waiting to be downloaded. A playlist larger than
# this is made a part at a time: it waits until the ready part is downloaded.
QUOTA_GB=3
# Space all the browsers at one IP address may have waiting together, so that
# throwing the cookie away does not give more space. Empty = twice QUOTA_GB.
IP_QUOTA_GB=
# Space all visitors together may use.
TOTAL_STORAGE_GB=20
# Minutes a finished file waits before it is deleted if nobody downloads it.
# A playlist waiting for a part to be downloaded is cancelled after the same time.
FILE_TTL_MINUTES=15

# ---- Limits ---------------------------------------------------------------
MAX_TRACKS=100            # tracks taken from one playlist
MAX_PLAYLIST_GB=30        # most that one link may add up to, over all its parts
MAX_LINKS=25              # song links accepted in one paste
MAX_COVER_MB=10           # largest image accepted as a new cover
MAX_TRACK_MINUTES=90      # longest single video
MAX_SOURCE_MB=500         # largest source download
MAX_UPLOAD_MB=678         # largest file the inspector accepts (a DSD or hi-res FLAC song is easily several hundred MB)
# A file reaches the inspector in pieces, so that it passes a proxy that caps the
# size of one request (Cloudflare: 100 MB on the Free and Pro plans). If nginx is
# in front, its client_max_body_size must be at least one piece (default 1m is not).
UPLOAD_CHUNK_MB=8         # size of one piece
UPLOAD_TIMEOUT_SEC=120    # each piece has to arrive within this
UPLOAD_TOTAL_MINUTES=30   # and the whole file within this
RATE_INSPECT_PER_MIN=10   # files offered to the inspector per minute, per visitor
MAX_CONCURRENT=2          # links processed at the same time
MAX_JOBS_PER_CLIENT=3     # links one visitor may have in progress
RATE_CONVERT_PER_MIN=5    # new links per minute, per visitor
RATE_SEARCH_PER_MIN=10    # searches by song name per minute, per visitor
RATE_EDIT_PER_MIN=20      # tag edits, lookups and cover uploads per minute, per visitor
RATE_GLOBAL_PER_MIN=300   # all requests per minute, per visitor
DOWNLOAD_TIMEOUT_SEC=600
CONVERT_TIMEOUT_SEC=900

# ---- Metadata -------------------------------------------------------------
METADATA_LOOKUP=on        # off = tag from YouTube data only
LYRICS=on                 # off = never look up lyrics
# The country whose stores are searched (iTunes, Tidal, Spotify).
ITUNES_COUNTRY=US
# The catalogues a song is looked up in, in the order they are asked. The search
# stops at the first one with a good match; the next ones are asked only for what
# that one left empty (genre, year, track number, artwork). Leave empty for:
#   itunes deezer tidal spotify musicbrainz discogs lastfm
# iTunes, Deezer and MusicBrainz are open. The other four are asked only when
# their key below is set; without it they are skipped, whatever this list says.
CATALOGUES=
# Keys for the catalogues that need one. Each is free to get and identifies this
# server, never a visitor. They are sent only to the service they belong to and
# are never logged or sent to a browser. Keep this file private.
#   Tidal:   https://developer.tidal.com  (create an app: client id and secret)
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
#   Spotify: https://developer.spotify.com/dashboard  (create an app; since 2026 the
#            account that owns it needs Spotify Premium, and a search returns 10 songs at most)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
#   Discogs: https://www.discogs.com/settings/developers  (generate a personal access token)
DISCOGS_TOKEN=
#   Last.fm: https://www.last.fm/api/account/create  (the "API key", not the shared secret)
LASTFM_API_KEY=

# ---- Extras ---------------------------------------------------------------
# SoundCloud gives only a 30-second preview of some songs (they need Go+).
# on = fetch the whole song from YouTube instead; off = that track fails.
SOUNDCLOUD_FALLBACK=on
SEARCH=on                 # off = links only, no search by song name
INSPECT=on                # off = no metadata inspector, so nobody can upload a file to read
# on = a visitor may keep the file they inspect for a short while, correct its tags
# and download it again (one file per browser, counted against their space).
# off = every inspected file is read once and deleted straight away.
INSPECT_EDIT=on
# Kinds of file the inspector accepts, judged by the file's bytes, not its
# name. Leave empty for all of them: mp3 flac wav aiff m4a ogg opus dsf mka
INSPECT_TYPES=
PREVIEW=on                # off = no in-page player (saves one encode per track)
PREVIEW_MINUTES=10        # longest preview kept per track
LOUDNESS_LUFS=-14         # level aimed for by "Even out the loudness"
ONLINE_COUNT=on           # off = no "people online" number in the header, and no check-ins kept for it

